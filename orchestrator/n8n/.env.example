# Anthropic API key — required for all LLM-backed workflows
# Stored in n8n as credential "Anthropic account" (type: anthropicApi)
# Get it at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Microsoft Graph application credentials
# NOTE: This is a SEPARATE App Registration from the Teams bot (which lives in
# tenant 0d9ed809-... / ilya.staradubets@gmail.com). Graph access for SharePoint
# state store uses a dedicated App Reg in the dev tenant (t8lxc.onmicrosoft.com),
# created per sharepoint-setup.md section 5.
# Required Graph permissions: Sites.ReadWrite.All, Files.ReadWrite.All, User.Read.All
AZURE_GRAPH_CLIENT_ID=
AZURE_GRAPH_CLIENT_SECRET=
AZURE_GRAPH_TENANT_ID=

# SharePoint identifiers — resolve via Graph after creating the site
# See sharepoint-setup.md section 7 for the resolution queries
SHAREPOINT_SITE_URL=
SHAREPOINT_TENANT=
SHAREPOINT_CONVERSATIONS_LIST_ID=
SHAREPOINT_TURNS_LIST_ID=
SHAREPOINT_DRIVE_ID=

# PnP.PowerShell app registration — used for SharePoint admin/setup scripts only
# Register via: Register-PnPEntraIDAppForInteractiveLogin -ApplicationName "PnP.PowerShell" -Tenant t8lxc.onmicrosoft.com
PNP_CLIENT_ID=
PNP_TENANT=t8lxc.onmicrosoft.com
PNP_SHAREPOINT_URL=https://t8lxc.sharepoint.com/sites/PresaleAgentBot
