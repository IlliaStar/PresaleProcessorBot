# Azure Bot Service — from Azure App Registration
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TYPE=SingleTenant
MICROSOFT_APP_TENANT_ID=

# Server
PORT=3978

# n8n orchestrator webhook endpoint
N8N_WEBHOOK_URL=http://localhost:5678/webhook/presale-agent

# Timeout (ms) waiting for n8n to respond
N8N_TIMEOUT=120000
