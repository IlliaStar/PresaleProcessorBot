<?xml version="1.0" encoding="utf-8"?>
<pnp:ListInstance xmlns:pnp="http://schemas.dev.office.com/PnP/2022/09/ProvisioningSchema" Title="Conversations"
                          Description="Per-conversation state for the presale agent"
                          TemplateType="100"
                          Url="Lists/Conversations"
                          EnableVersioning="true"
                          OnQuickLaunch="true">
  <pnp:ContentTypeBindings>
    <pnp:ContentTypeBinding ContentTypeID="0x01" Default="true" />
  </pnp:ContentTypeBindings>
  <pnp:Fields>
    <!-- 1. conversationId — required, unique -->
    <pnp:Field Type="Text"
                       Name="conversationId"
                       DisplayName="Conversation ID"
                       Required="TRUE"
                       EnforceUniqueValues="TRUE"
                       Indexed="TRUE"
                       MaxLength="255"
                       ID="{FFF6BFAF-6E7D-4DC4-A757-6EBC31135B66}" />
    <!-- 2. userId -->
    <pnp:Field Type="Text"
                       Name="userId"
                       DisplayName="User ID"
                       Required="FALSE"
                       MaxLength="255"
                       ID="{DD100431-CBAE-4B3C-B0D5-321CA657CC6E}" />
    <!-- 3. userName -->
    <pnp:Field Type="Text"
                       Name="userName"
                       DisplayName="User Name"
                       Required="FALSE"
                       MaxLength="255"
                       ID="{C27546CF-CB85-41F1-9372-DC644F1C2ABE}" />
    <!-- 4. channelId — default: msteams -->
    <pnp:Field Type="Text"
                       Name="channelId"
                       DisplayName="Channel ID"
                       Required="FALSE"
                       MaxLength="255"
                       DefaultValue="msteams"
                       ID="{A6B18AF9-B0A1-4328-999B-EA53CC7B1082}" />
    <!-- 5. currentStep — Choice, default: new -->
    <pnp:Field Type="Choice"
                       Name="currentStep"
                       DisplayName="Current Step"
                       Required="FALSE"
                       Default="new"
                       ID="{7C4AB5BE-FC90-4525-B35D-E3CA4F108D77}">
      <CHOICES>
        <CHOICE>new</CHOICE>
        <CHOICE>intake</CHOICE>
        <CHOICE>clarification</CHOICE>
        <CHOICE>estimation</CHOICE>
        <CHOICE>review</CHOICE>
        <CHOICE>completed</CHOICE>
      </CHOICES>
    </pnp:Field>
    <!-- 6. status — Choice, default: Active -->
    <pnp:Field Type="Choice"
                       Name="status"
                       DisplayName="Status"
                       Required="FALSE"
                       Default="Active"
                       ID="{CB38E5DC-0EAD-4C93-806E-608B86350BEF}">
      <CHOICES>
        <CHOICE>Active</CHOICE>
        <CHOICE>Archived</CHOICE>
      </CHOICES>
    </pnp:Field>
    <!-- 7. createdAt — DateTime with time -->
    <pnp:Field Type="DateTime"
                       Name="createdAt"
                       DisplayName="Created At"
                       Required="FALSE"
                       Format="DateTime"
                       ID="{38078FC3-3717-4562-BC66-FDE50F86747D}" />
    <!-- 8. modifiedAt — DateTime with time -->
    <pnp:Field Type="DateTime"
                       Name="modifiedAt"
                       DisplayName="Modified At"
                       Required="FALSE"
                       Format="DateTime"
                       ID="{910BB83C-95CD-4D31-B1D6-4DE77E5339C2}" />
    <!-- 9. clarificationTurns — Number, default: 0, min: 0 -->
    <pnp:Field Type="Number"
                       Name="clarificationTurns"
                       DisplayName="Clarification Turns"
                       Required="FALSE"
                       DefaultValue="0"
                       MinimumValue="0"
                       ID="{A92D7D64-ED02-46D5-844E-730DF633E747}" />
    <!-- 10. summary — Multi-line plain text -->
    <pnp:Field Type="Note"
                       Name="summary"
                       DisplayName="Summary"
                       Required="FALSE"
                       RichText="FALSE"
                       UnlimitedLengthInDocumentLibrary="FALSE"
                       ID="{C0ADFEEE-CEBF-4865-80C1-6A7357CE7948}" />
    <!-- 11. wbsArtifactRef — Hyperlink -->
    <pnp:Field Type="URL"
                       Name="wbsArtifactRef"
                       DisplayName="WBS Artifact"
                       Required="FALSE"
                       Format="Hyperlink"
                       ID="{988A8AEB-7AC2-485A-A58F-61F82AB75EB8}" />
    <!-- 12. lastTurnNo — Number, default: 0 -->
    <pnp:Field Type="Number"
                       Name="lastTurnNo"
                       DisplayName="Last Turn No"
                       Required="FALSE"
                       DefaultValue="0"
                       ID="{5806F495-01ED-4FFA-99C7-24F8DBCFBC78}" />
  </pnp:Fields>
  <pnp:Views>
    <pnp:View DefaultView="TRUE" MobileDefaultView="TRUE" MobileView="TRUE"
                      Name="All Items" DisplayName="All Items"
                      Type="HTML" Url="Lists/Conversations/AllItems.aspx">
      <ViewFields>
        <FieldRef Name="conversationId" />
        <FieldRef Name="userId" />
        <FieldRef Name="userName" />
        <FieldRef Name="channelId" />
        <FieldRef Name="currentStep" />
        <FieldRef Name="status" />
        <FieldRef Name="clarificationTurns" />
        <FieldRef Name="lastTurnNo" />
        <FieldRef Name="createdAt" />
        <FieldRef Name="modifiedAt" />
      </ViewFields>
      <Query>
        <OrderBy>
          <FieldRef Name="modifiedAt" Ascending="FALSE" />
        </OrderBy>
      </Query>
    </pnp:View>
  </pnp:Views>
</pnp:ListInstance>