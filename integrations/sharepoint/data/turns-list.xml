<?xml version="1.0" encoding="utf-8"?>
<pnp:ListInstance xmlns:pnp="http://schemas.dev.office.com/PnP/2022/09/ProvisioningSchema" Title="Turns"
                          Description="One item per message turn in a conversation"
                          TemplateType="100"
                          Url="Lists/Turns"
                          EnableVersioning="false"
                          OnQuickLaunch="true">
  <pnp:ContentTypeBindings>
    <pnp:ContentTypeBinding ContentTypeID="0x01" Default="true" />
  </pnp:ContentTypeBindings>
  <pnp:Fields>
    <!-- 1. conversationId — required, indexed -->
    <pnp:Field Type="Text"
                       Name="conversationId"
                       DisplayName="Conversation ID"
                       Required="TRUE"
                       Indexed="TRUE"
                       MaxLength="255"
                       ID="{3596099B-1BB3-4451-8272-1BFAB34C1A26}" />
    <!-- 2. turnNo — required, indexed, decimals: 0 -->
    <pnp:Field Type="Number"
                       Name="turnNo"
                       DisplayName="Turn No"
                       Required="TRUE"
                       Indexed="TRUE"
                       Decimals="0"
                       MinimumValue="1"
                       ID="{7ACBED82-9D37-41AD-9092-3E0B22473698}" />
    <!-- 3. role — user | assistant -->
    <pnp:Field Type="Choice"
                       Name="role"
                       DisplayName="Role"
                       Required="FALSE"
                       Default="user"
                       ID="{B8F8F3E5-9AB2-4F26-B1C2-56E6E5DDC172}">
      <CHOICES>
        <CHOICE>user</CHOICE>
        <CHOICE>assistant</CHOICE>
      </CHOICES>
    </pnp:Field>
    <!-- 4. step — lifecycle step at time of turn -->
    <pnp:Field Type="Choice"
                       Name="step"
                       DisplayName="Step"
                       Required="FALSE"
                       Default="new"
                       ID="{3AA9AD77-81CE-4920-982C-2BB2C2CEDE94}">
      <CHOICES>
        <CHOICE>new</CHOICE>
        <CHOICE>intake</CHOICE>
        <CHOICE>clarification</CHOICE>
        <CHOICE>estimation</CHOICE>
        <CHOICE>review</CHOICE>
        <CHOICE>completed</CHOICE>
      </CHOICES>
    </pnp:Field>
    <!-- 5. intent — classifier output (user turns only) -->
    <pnp:Field Type="Text"
                       Name="intent"
                       DisplayName="Intent"
                       Required="FALSE"
                       MaxLength="255"
                       ID="{E388154E-42D8-41F3-9A94-107C4D8866CF}" />
    <!-- 6. text — message body, SP limit ~63K chars -->
    <pnp:Field Type="Note"
                       Name="text"
                       DisplayName="Text"
                       Required="FALSE"
                       RichText="FALSE"
                       ID="{B0534E5A-64C0-419C-B71A-7E2880A1C1F7}" />
    <!-- 7. ts — turn timestamp, include time -->
    <pnp:Field Type="DateTime"
                       Name="ts"
                       DisplayName="Timestamp"
                       Required="FALSE"
                       Format="DateTime"
                       ID="{70061144-E5C3-4815-8675-1A33A21AEAA2}" />
    <!-- 8. overflowRef — link to transcript-overflow-<n>.md when text >63K -->
    <pnp:Field Type="URL"
                       Name="overflowRef"
                       DisplayName="Overflow Ref"
                       Required="FALSE"
                       Format="Hyperlink"
                       ID="{CFD9CAB6-BEFB-459D-8EC2-0F04BC86AB9D}" />
    <!-- 9. attachmentsJson — [{name, contentType, sizeBytes}] plain text -->
    <pnp:Field Type="Note"
                       Name="attachmentsJson"
                       DisplayName="Attachments JSON"
                       Required="FALSE"
                       RichText="FALSE"
                       ID="{E1058118-7BB9-46CC-947E-89C1B66CDD59}" />
  </pnp:Fields>
  <pnp:Views>
    <pnp:View DefaultView="TRUE" MobileDefaultView="TRUE" MobileView="TRUE"
                      Name="By Conversation" DisplayName="By Conversation"
                      Type="HTML" Url="Lists/Turns/AllItems.aspx">
      <ViewFields>
        <FieldRef Name="conversationId" />
        <FieldRef Name="turnNo" />
        <FieldRef Name="role" />
        <FieldRef Name="step" />
        <FieldRef Name="intent" />
        <FieldRef Name="ts" />
        <FieldRef Name="text" />
      </ViewFields>
      <Query>
        <GroupBy>
          <FieldRef Name="conversationId" />
        </GroupBy>
        <OrderBy>
          <FieldRef Name="turnNo" Ascending="TRUE" />
        </OrderBy>
      </Query>
    </pnp:View>
  </pnp:Views>
</pnp:ListInstance>